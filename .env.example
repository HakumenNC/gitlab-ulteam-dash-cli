# Instance GitLab (defaut : https://gitlab.com)
GITLAB_URL=https://gitlab.com

# Personal access token, scope `api` (ou `read_api` suffit pour ce CLI)
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# IDs numeriques des membres de l'equipe, separes par des virgules.
# Utilise par la commande `team`.
GITLAB_TEAM_IDS=327,364
